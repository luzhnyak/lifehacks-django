# Copy this template to .env in the project root; Django loads it automatically.
# Existing process environment variables take precedence over this file.
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# Production: DEBUG=false and a new random secret are required.
# DJANGO_SECRET_KEY=generate-a-new-random-key
# DJANGO_ALLOWED_HOSTS=lifehacks.in.ua,www.lifehacks.in.ua
# DJANGO_CSRF_TRUSTED_ORIGINS=https://lifehacks.in.ua,https://www.lifehacks.in.ua
# DJANGO_MEDIA_ROOT=/absolute/path/to/media
# DJANGO_TRUST_PROXY_HTTPS=true
